# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# API Key Authentication (optional)
# Leave API_KEY unset (commented out) to run in open-access mode — no key required.
# Set it to enable API-key authentication on all protected routes:
#   protected routes check the X-API-Key request header against this value.
#   Missing or incorrect key → HTTP 401.
# API_KEY=your-secret-key-here

# Cors Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Telemetry Engine Settings
DEFAULT_MAX_WORK=4096
DEFAULT_KV_CAPACITY=8192
